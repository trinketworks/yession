@@ -587,6 +600,22 @@
 }
 
 /**
+ * Close-on-exec FD
+ *
+ * openpty(3), forkpty(3) and posix_openpt(3) all leave the master inheritable,
+ * so without this every process the embedding program execs afterwards --
+ * through child_process, or through a later fork() here -- holds the master
+ * of every pty already open: the keyboard of each of those terminals.
+ */
+
+static int
+pty_cloexec(int fd) {
+  int flags = fcntl(fd, F_GETFD, 0);
+  if (flags == -1) return -1;
+  return fcntl(fd, F_SETFD, flags | FD_CLOEXEC);
+}
+
+/**
