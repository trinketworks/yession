<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One of two projects for YES013, and the one that carries the rule's cases: a Yession project,
    which is product code whatever it references, so every hand-built JavaScript object and every
    nullable type it declares is reported. It is the Domain's shape on purpose — a Yession project
    that references nothing — because YES013 judges a project by what is in its reach, and the
    definition of that reach is shared with YES011 (`Population.reach`), whose own fixtures show
    the other shape: a project that is not named Yession but references one.

    Its pair is BindingOnlyInBindingFixture, which declares the same things with nothing Yession in
    reach and must be reported clean. Not in Yession.slnx, for the reason no fixture is.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

</Project>
