<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not a product project and deliberately not in Yession.slnx, for the same reason
    EmitMacroFixture is not: every binding below is there to be judged, and some of them
    are meant to fail. `lint` analyzes it on its own and checks the verdicts against the
    `// YES012` markers in the source.

    Three files, because the rule is about how many of them hand a page JavaScript: one file
    could not break it, so one file could not prove the rule still sees a break either.
    `Typed.fs` earns its place by being reported NOWHERE while driving the same page through
    every Playwright call that takes no JavaScript.

    The real Playwright package, not a stand-in with the same names: what the rule reads is the
    typed tree FCS builds for a call on an interface member of a referenced assembly, generic
    and overloaded, which a fixture of its own types would not exercise.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Typed.fs" />
    <Compile Include="Seam.fs" />
    <Compile Include="Elsewhere.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
