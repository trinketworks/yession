<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The other half of YES016: a binding project, with nothing Yession in its reach, may cast,
    because it is where a value of no declared type is given one. Every cast below is one
    Yession.UncheckedCastFixture is reported for, and nothing here is marked. A finding would mean
    the rule had started rejecting the src/Fable.* projects, the serial example and the other
    fixtures.

    Not in Yession.slnx, for the reason no fixture is.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Binding.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

</Project>
