<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This is not a product project, and it is not in Yession.slnx, for the reason that no fixture
    is. Each call in Signals.fs is there for the rule to judge, and the rule must report most of
    them. `lint` analyzes the project on its own and checks the verdicts against the `// YES021`
    markers in the source.

    This project references nothing of the product, as a binding project does. YES021 judges
    each project, so it reports here too.

    Fable.Node is a reference. The project does not declare the types of that library under
    their names. The rule matches the members of the library, so a release of the library that
    moves them makes this fixture red.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Signals.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Node" />
  </ItemGroup>

</Project>
