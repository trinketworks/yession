<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The other half of YES017: a binding project, with nothing Yession in its reach, may declare
    `obj` in a signature, because it is the edge where a value of no declared type is given one.
    Every signature below is one Yession.ObjSignatureFixture is reported for, and nothing here is
    marked. A finding would mean the rule had started rejecting the src/Fable.* projects, the
    serial example and the other fixtures.

    Yession.ObjSignatureFixture references this project for its `Json` abbreviation. Not in
    Yession.slnx, for the reason no fixture is.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Binding.fs" />
  </ItemGroup>

</Project>
