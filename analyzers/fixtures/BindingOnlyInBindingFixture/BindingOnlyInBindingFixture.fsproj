<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The other half of YES013: a binding project — nothing Yession in its reach, neither its own name
    nor any reference — may build an object by hand and declare a nullable type as it likes. Every
    construct below is one Yession.BindingOnlyFixture is reported for, and nothing here is marked. A
    finding would mean the rule had started rejecting the src/Fable.* projects, the serial example
    and the other fixtures, which are where these belong.

    Not in Yession.slnx, for the reason no fixture is.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Binding.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

</Project>
