<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not a product project and deliberately not in Yession.slnx, for the same reason the other
    fixtures are not: every sleep in Sleeps.fs is there to be judged, and most of them are
    meant to fail. `lint` analyzes it on its own and checks the verdicts against the
    `// YES014` markers in the source. Fable.Core and Fable.Promise are referenced for the
    timer and the promise sleep, so the rule is shown to see those two by their symbols too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sleeps.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Promise" />
  </ItemGroup>

</Project>
