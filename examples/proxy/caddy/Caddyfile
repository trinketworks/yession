# One reverse proxy in front of a Yession deployment, behind whatever terminated TLS and
# authenticated the caller. Here that is `tailscale serve`, which asserts the calling tailnet
# user in `Tailscale-User-*` headers and overwrites any a client sent — so a single mapping,
#
#   sudo tailscale serve --bg --https=8321 unix:/var/lib/yession/proxy.sock
#
# is the whole of the ingress, and everything else (routing, the identity translation) is
# in this file, where it can be read, versioned and tested.
#
# Both doors are UNIX SOCKETS, and that is the security of the whole arrangement. This proxy
# believes `Tailscale-User-Login`, and the Manager believes the `x-yession-user` this proxy
# sets from it. A header is true only if nothing but its sender could have sent it, and a
# TCP port on loopback cannot promise that: every process on the host dials it, and so does
# a container whose network reaches the host loopback (Colima's and Docker Desktop's do).
# A socket's permissions can: `serve` (root) opens this one, this proxy opens the Manager's,
# and a sandbox or a container has no path to either.
#
# Three variables, read once when the Caddyfile is adapted:
#
#   YESSION_PROXY_SOCKET    the socket this proxy listens on — what `serve` targets, an
#                           absolute path, e.g. /var/lib/yession/proxy.sock
#   YESSION_PROXY_MANAGER   the Manager's socket as Caddy dials one,
#                           e.g. unix//var/lib/yession/manager.sock (the Manager's --socket)
#   YESSION_PROXY_SESSIONS  a glob over the session map ../main.mjs writes,
#                           e.g. /var/lib/yession/proxy/sessions*.caddy
#
# Run it with `--watch`: Caddy re-adapts this file every second, which re-reads the import,
# so a rewritten map is live within a second and nothing has to tell Caddy to reload.
{
	admin off
	auto_https off
	persist_config off
}

# The site address names no host on purpose, twice over. A host in it (`127.0.0.1`) becomes
# a Host MATCHER, and every request through `serve` carries the tailnet name as its Host — so
# nothing matched and Caddy answered an empty 200 to everything. And a host in it is served
# over TLS by default, `auto_https off` notwithstanding: that only stops the certificate
# machinery. `http://` says TLS is the ingress's job; `bind` says where to listen.
http:// {
	# A socket, owner and group only, or the translation below is a hole: anything that can
	# dial this door can write its own `Tailscale-User-Login`, and the proxy would believe
	# it. `serve` is the only thing that should be able to reach here.
	bind unix/{$YESSION_PROXY_SOCKET}|0660

	# One line per request: the method, the URI, the status and how long it took, beside the
	# time, level and logger every Caddy line carries. Enough to see which step of a slow open hung (the `/open` screen, its readiness
	# poll, the sign-in bounce, the shell), and nothing about who asked. On stdout, apart
	# from Caddy's own errors on stderr, so whatever keeps this process's output keeps it.
	# The sign-in bounce carries a one-time code and its state in the query, so those two
	# are dropped from the URI.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
				}
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>proto delete
				request>host delete
				request>headers delete
				request>tls delete
				bytes_read delete
				user_id delete
				size delete
				resp_headers delete
			}
		}
	}

	# Sessions first. Each is a `handle` over its own `/s/<id>` mount, rendered per frame by
	# main.mjs through the template the deployment gives it. A glob matching nothing is a
	# warning at adapt time and not an error, so a cold boot with no map yet still serves the
	# Manager — and the `/open` page waits on the mapping rather than racing it. Under
	# `--watch` that adapt runs every second, so give main.mjs `--empty '# no sessions'`:
	# an EMPTY import is a warning too, and one a line a second for as long as nothing runs.
	import {$YESSION_PROXY_SESSIONS}

	# Everything else is the Manager's. The identity translation happens here and ONLY here:
	# a session authenticates its visitors through the Manager as OIDC issuer, never by
	# header, so the session routes above carry nothing of the kind.
	handle {
		reverse_proxy {$YESSION_PROXY_MANAGER} {
			# SET the three Yession reads from the three `serve` asserts. `header_up` with a
			# value replaces whatever the client sent under that name — that IS the strip for
			# these three, and `serve` has already overwritten the source of each.
			header_up x-yession-user {header.Tailscale-User-Login}
			header_up x-yession-user-name {header.Tailscale-User-Name}
			header_up x-yession-user-picture {header.Tailscale-User-Profile-Pic}
			# DELETE the two it reads that `serve` does not assert, or a client chooses its own
			# email and claims. Named one by one rather than `-x-yession-*`: Caddy applies
			# deletions AFTER sets, so the wildcard would take the three above with it
			# (measured: the request arrived with no identity at all — and kept measured by
			# the fronted browser case in tests/Yession.Tests, which runs this file).
			header_up -x-yession-user-email
			header_up -x-yession-user-claims
			# Translated, so nothing downstream reads an identity Yession did not sanction.
			header_up -tailscale-*
		}
	}
}
