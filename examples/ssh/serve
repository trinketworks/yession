#!/bin/sh
# serve: one SSH connection, served on the input and the output of this script.
#
# This script runs IN a sandbox, as the command of one entry (`yession-enter ... -- serve`).
# It starts `sshd -i`, which is the mode of sshd for one connection that is already open. No
# daemon runs in the sandbox, and nothing in the sandbox listens on a port.
#
#   serve [--for LOGIN] [--trusted] [--prepared] [AUTHORIZED_KEYS]
#   serve --prepare
#
#   --for LOGIN       the person that the host named for this connection. When the directory
#                     `authorized_keys.d` is beside this script, only the keys in the file
#                     `authorized_keys.d/LOGIN` can log in. See "the keys of one person".
#   --trusted         the host proved who the person is, so the person logs in with no key.
#                     Needs `--for`. See "a login with no key".
#   --prepare         make the host key and keep the PATH of this run, then stop. See "a
#                     sandbox with a slow entrypoint".
#   --prepared        use the PATH that `--prepare` kept, and not the PATH of this run.
#   AUTHORIZED_KEYS   the public keys that can log in. Default: $YESSION_SSH_AUTHORIZED_KEYS,
#                     then the file `authorized_keys` beside this script.
#   YESSION_SSH_STATE the directory for the host key of this user. Default:
#                     ${XDG_STATE_HOME:-$HOME/.local/state}/yession-ssh
#   YESSION_SSH_SSHD  the sshd to run. Default: the first `sshd` on PATH, then /usr/sbin/sshd.
#
# The person logs in as the user that runs this script, which is the user of the sandbox.
# For a sandbox that runs as root, see "a sandbox that runs as root" below.
set -eu

say() {
    printf 'serve: %s\n' "$*" >&2
}

# has_entry NAME FILE: the file has a line for this name. The shell alone, with no grep.
has_entry() {
    [ -r "$2" ] || return 1
    while IFS=: read -r name _; do
        [ "$name" = "$1" ] && return 0
    done < "$2"
    return 1
}

login=
trusted=no
prepare=no
prepared=no
while [ $# -gt 0 ]; do
    case $1 in
        --for)
            if [ $# -lt 2 ]; then
                say '--for needs a login.'
                exit 64
            fi
            login=$2
            shift 2
            ;;
        --trusted)
            trusted=yes
            shift
            ;;
        --prepare)
            prepare=yes
            shift
            ;;
        --prepared)
            prepared=yes
            shift
            ;;
        *) break ;;
    esac
done

state=${YESSION_SSH_STATE:-${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/yession-ssh}

# --- a sandbox with a slow entrypoint ----------------------------------------------------
#
# Each entry runs behind the entrypoint of the sandbox, and an entrypoint can take seconds
# (`nix develop`, for example). An SSH connection is one entry, so each connection waited.
# The entrypoint gives this script one thing that it needs: the PATH, which finds sshd and
# which the person gets. So the deployment runs `serve --prepare` one time behind the
# entrypoint, which keeps the PATH in a file. Each connection then runs `serve --prepared`
# with no entrypoint (`yession-enter --bare`), and reads the PATH from the file.
#
# The file is as old as the listener of the deployment. A change of the entrypoint shows
# after the sandbox starts again.
kept=$state/path
if [ "$prepared" = yes ]; then
    if [ -r "$kept" ]; then
        IFS= read -r PATH < "$kept" || true
        export PATH
    else
        say "no PATH at $kept. Run serve --prepare behind the entrypoint first. This run uses its own PATH."
    fi
fi

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
keys=${1:-${YESSION_SSH_AUTHORIZED_KEYS:-$here/authorized_keys}}

# --- the keys of one person --------------------------------------------------------------
#
# With one file of keys, each key opens each sandbox under each name. The host names the
# person (`listen.mjs --whois`) and gives the name here as `--for`. When the operator
# supplies a directory `authorized_keys.d`, a name opens the sandbox only with a key from
# its own file. A process that gives a false name to the host thus also needs the private
# key of that person. A name with no file can not log in.
#
# --- a login with no key -----------------------------------------------------------------
#
# A deployment can know the person before SSH starts: a tailnet proves who dials, for
# example, and its policy says who can reach the port. With `--trusted`, this script
# believes the name from `--for` and asks for no key. sshd then accepts the method `none`.
#
# Use it only when each connection to the listener comes from the part of the deployment
# that proved the name. If another process on the host can dial the listener, that process
# enters with a name of its choice and no key. docs/deployment.md says what the host must
# then do.
#
# sshd accepts `none` only for an account whose password is empty, so this script empties
# the password of root. It can do that only in a sandbox that runs as root.
if [ "$trusted" = yes ]; then
    if [ -z "$login" ]; then
        say '--trusted needs --for, the name that the host proved.'
        exit 64
    fi
    if [ "$(id -u)" != 0 ]; then
        say '--trusted needs a sandbox that runs as root. This sandbox does not.'
        exit 78
    fi
    keys=none
elif [ -n "$login" ] && [ -d "$here/authorized_keys.d" ]; then
    case $login in
        */* | .* | '')
            say "the login '$login' is not a name of a file of keys."
            exit 78
            ;;
    esac
    keys=$here/authorized_keys.d/$login
    if [ ! -r "$keys" ]; then
        say "no keys for $login at $keys. The operator adds a file for each person who can enter."
        exit 78
    fi
fi
# sshd finds the home and the shell of the user in the password database.
if ! id -un >/dev/null 2>&1; then
    say "the user $(id -u) has no entry in the password database of this sandbox."
    exit 78
fi

sshd=${YESSION_SSH_SSHD:-}
if [ -z "$sshd" ]; then
    sshd=$(command -v sshd 2>/dev/null || true)
    if [ -z "$sshd" ] && [ -x /usr/sbin/sshd ]; then
        sshd=/usr/sbin/sshd
    fi
fi
if [ -z "$sshd" ] || [ ! -x "$sshd" ]; then
    say 'sshd is not installed in this sandbox. Add the OpenSSH server to the image.'
    exit 78
fi

# ssh-keygen is beside sshd in each OpenSSH package. PATH is the second place to look.
keygen=$(dirname -- "$sshd")/ssh-keygen
if [ ! -x "$keygen" ]; then
    keygen=$(dirname -- "$(dirname -- "$sshd")")/bin/ssh-keygen
fi
if [ ! -x "$keygen" ]; then
    keygen=$(command -v ssh-keygen 2>/dev/null || true)
fi
if [ -z "$keygen" ]; then
    say 'ssh-keygen is not installed in this sandbox. It comes with the OpenSSH server.'
    exit 78
fi

if [ "$prepare" != yes ] && [ "$trusted" != yes ] && [ ! -r "$keys" ]; then
    say "no authorized keys at $keys. The resource of the operator supplies this file."
    exit 78
fi

# One host key for each user of each sandbox, made at the first entry. A sandbox that keeps
# its home keeps its key, and the client of the person then knows the sandbox again.
key=$state/ssh_host_ed25519_key
if [ ! -f "$key" ]; then
    mkdir -p "$state"
    chmod 700 "$state"
    if ! "$keygen" -q -t ed25519 -N '' -f "$key.$$" </dev/null >&2; then
        say 'ssh-keygen did not make a host key.'
        exit 78
    fi
    # Two entries can start at the same time. The rename makes one of the two keys the key.
    mv -f "$key.$$" "$key"
    rm -f "$key.$$.pub"
fi

if [ "$prepare" = yes ]; then
    # Written beside its name and then renamed, so a connection never reads a part of it.
    printf '%s\n' "${PATH:-}" > "$kept.$$"
    mv -f "$kept.$$" "$kept"
    exit 0
fi

# --- a sandbox that runs as root ---------------------------------------------------------
#
# As root, sshd separates privileges. Before the login it changes its root directory to
# /var/empty and becomes the user `sshd`. After the login it becomes the person's user. That
# needs three capabilities that a hardened container does not have: SYS_CHROOT, SETUID and
# SETGID. An operator grants them to a sandbox with a `capability:` resource. It also needs
# the directory, the user, and a root account that is not locked. A container image that
# never ran a daemon has none of the three, so this script makes them.
root_login=no
if [ "$(id -u)" = 0 ]; then
    root_login=prohibit-password
    # What the password field of root must hold. `*` is no password and no lock, so only a
    # key can log in. Empty is a password of nothing, which the method `none` needs.
    field='*'
    if [ "$trusted" = yes ]; then
        root_login=yes
        field=
    fi

    # Bits 6 (SETGID), 7 (SETUID) and 18 (SYS_CHROOT) of the effective set.
    # Read with the shell alone: an image can be without sed and grep.
    effective=
    if [ -r /proc/self/status ]; then
        while read -r field value; do
            [ "$field" = CapEff: ] && effective=$value
        done < /proc/self/status
    fi
    if [ "${#effective}" = 16 ]; then
        missing=
        low=$((0x${effective#????????}))
        [ $((low >> 7 & 1)) = 1 ] || missing="$missing SETUID"
        [ $((low >> 6 & 1)) = 1 ] || missing="$missing SETGID"
        [ $((low >> 18 & 1)) = 1 ] || missing="$missing SYS_CHROOT"
        if [ -n "$missing" ]; then
            say "this sandbox runs as root and does not have the capabilities:$missing."
            say 'sshd needs them to change user. The resource of the operator grants them:'
            say '  capability: [ SETUID, SETGID, SYS_CHROOT ]'
            exit 78
        fi
    fi

    if [ ! -d /var/empty ]; then
        if ! mkdir -p /var/empty; then
            say 'this script can not make the directory /var/empty, which sshd needs.'
            exit 78
        fi
    fi
    chmod 755 /var/empty

    if ! has_entry sshd /etc/passwd; then
        if ! printf 'sshd:x:74:74:sshd privilege separation:/var/empty:/bin/false\n' >> /etc/passwd; then
            say 'this script can not add the user sshd to /etc/passwd, which sshd needs.'
            exit 78
        fi
        has_entry sshd /etc/group || printf 'sshd:x:74:\n' >> /etc/group || true
    fi

    # sshd refuses a locked account before it reads a key. `!` in the password field is a
    # lock. A login with a key changes only a lock. A login with no key changes each value
    # that is not empty. The file is written in place, because a rename can not replace a
    # file that is a mount.
    if [ -f /etc/shadow ]; then
        changed=no
        written=
        while IFS= read -r line || [ -n "$line" ]; do
            case $line in
                root:*)
                    rest=${line#root:}
                    now=${rest%%:*}
                    change=no
                    case $now in
                        '!'*) change=yes ;;
                    esac
                    if [ "$trusted" = yes ] && [ -n "$now" ]; then
                        change=yes
                    fi
                    if [ "$change" = yes ]; then
                        changed=yes
                        line="root:$field:${rest#*:}"
                    fi
                    ;;
            esac
            written="$written$line
"
        done < /etc/shadow
        if [ "$changed" = yes ] && ! printf %s "$written" > /etc/shadow; then
            say 'this script can not write the password field of root in /etc/shadow.'
            exit 78
        fi
    elif [ "$trusted" = yes ]; then
        say '--trusted needs the file /etc/shadow, and this sandbox has none.'
        exit 78
    fi
fi

# A login shell from sshd starts with a new environment. The PATH of this script is the PATH
# that the entrypoint of the sandbox made, so the person gets the same tools as a terminal
# of the session. No other variable crosses: a variable can hold a secret.
set_path=
case ${PATH:-} in
    '' | *[!A-Za-z0-9_/.:+@%=-]*) ;;
    *) set_path=yes ;;
esac

# -i   one connection, on the input and the output
# -E   the log goes to a file, and then to the error output, which the host of the
#      deployment keeps
# -f /dev/null   no configuration file of the image changes what this script decides
#
# StrictModes is off for one reason: the authorized keys are a file of the operator on a
# read-only mount, so its owner is not the user of the sandbox, and sshd in strict mode
# refuses a key file that the user does not own. The mount is read-only, so the sandbox can
# not add a key.
#
# The log goes to a file first (-E), and this script copies it to the error output when sshd
# ends. This script reads the log to find how the connection ended, see below.
#
# A login with no key is the method `none`, which sshd accepts when it permits a password
# of nothing. The person types no password, because the account has none.
with_key=yes
no_key=no
if [ "$trusted" = yes ]; then
    with_key=no
    no_key=yes
fi
log=$state/sshd.$$.log
mkdir -p "$state"
code=0
"$sshd" -i -E "$log" -f /dev/null \
    -o "HostKey=$key" \
    -o "AuthorizedKeysFile=$keys" \
    -o "PermitRootLogin=$root_login" \
    -o "PubkeyAuthentication=$with_key" \
    -o "PasswordAuthentication=$no_key" \
    -o "PermitEmptyPasswords=$no_key" \
    -o KbdInteractiveAuthentication=no \
    -o UsePAM=no \
    -o StrictModes=no \
    -o PidFile=none \
    -o PrintMotd=no \
    -o PrintLastLog=no \
    ${set_path:+-o "SetEnv=PATH=$PATH"} \
    -o 'Subsystem=sftp internal-sftp' || code=$?

# --- how the connection ended ------------------------------------------------------------
#
# `sshd -i` ends with the code 255 when the client disconnects, which is how each SSH
# connection ends. The session records the code of this script as the code of the entry, so
# each visit read as a failure. An ordinary end has two lines in the log: a login that sshd
# accepted, and a disconnect that the client asked for (reason 11 of the SSH protocol). This
# script gives the code 0 for that end. Each other end keeps the code of sshd: a login that
# failed, a connection that broke.
accepted=no
asked=no
if [ -r "$log" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        printf '%s\n' "$line" >&2
        case $line in
            'Accepted '*) accepted=yes ;;
            'Received disconnect from '*:11:*) asked=yes ;;
        esac
    done < "$log"
    rm -f "$log"
fi
if [ "$code" = 255 ] && [ "$accepted" = yes ] && [ "$asked" = yes ]; then
    exit 0
fi
exit "$code"
