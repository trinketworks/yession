<Project Sdk="Microsoft.NET.Sdk">

  <!-- A session's first load, frame by frame, against a real deployment: every painted frame
       and every client render, labelled so a picture can be traced to the render that drew it.
       An instrument on the same terms as the probe beside it — NOT shipped, and nothing
       arranges for it not to be: the package bundles from each bin's entry, so a project no
       bin references is simply never reached.

       What it takes, and why each: `Cli` is the Domain's, so this instrument declares and
       refuses its options the way every bin does; the `promise` builder is Fable.Promise's.
       From the App it takes two facts about the deployment it points a camera at —
       `ManagerRoute`, so the session it creates and stops is addressed through the same
       parser the Manager routes by, and `Dom.appId`, the element the client mounts into and
       therefore the one this waits for. Both are shared vocabulary the views, the suites and
       the browser shell already bind to; spelled again here they would be two authors of one
       fact, and a rename in the client would leave the camera waiting forever on an element
       that never appears. It drives nothing else of the App's: the page under the camera is
       whatever the deployment serves.

       The rest is the platform it drives Chromium over: `Fable.Fetch` for the Manager's
       routes, `Fable.NodeExtras` for the CDP socket and the process environment, and
       `Fable.BrowserExtras` for reading the path back off the address the Manager answered
       with — `URL` being a global on Node as much as in a browser. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Frames.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Node" />
    <PackageReference Include="Fable.Promise" />
    <PackageReference Include="Fable.Fetch" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Fable.BrowserExtras/Fable.BrowserExtras.fsproj" />
    <ProjectReference Include="../../src/Fable.NodeExtras/Fable.NodeExtras.fsproj" />
    <ProjectReference Include="../../src/Yession.Domain/Yession.Domain.fsproj" />
    <ProjectReference Include="../../src/Yession.App/Yession.App.fsproj" />
  </ItemGroup>

</Project>
