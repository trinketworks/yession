<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fable bindings to the corner of Yjs that `Fable.Yjs` types in a shape Yjs does not call:
    a document's `update` event. Fable-only, like app/Yession.Host.fsproj: `dotnet build`
    only type-checks it; the runnable JS comes from Fable. A standalone project so the
    bindings are a distinct layer, mirroring Fable.NodeExtras and Fable.BrowserExtras.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="YjsExtras.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Yjs" />
  </ItemGroup>

</Project>
