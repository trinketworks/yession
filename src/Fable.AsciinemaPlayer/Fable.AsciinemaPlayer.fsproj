<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fable bindings to the `asciinema-player` npm package — the client's replay of a closed
    terminal's recording. Fable-only, like app/Yession.Host.fsproj: `dotnet build` only
    type-checks it; the runnable JS comes from Fable. A standalone project so the bindings are
    a distinct layer, mirroring Fable.Jose / Fable.ProseMirror.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AsciinemaPlayer.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Browser.Dom" />
  </ItemGroup>

</Project>
