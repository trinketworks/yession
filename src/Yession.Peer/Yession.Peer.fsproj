<Project Sdk="Microsoft.NET.Sdk">

  <!-- The browser's own client, driven headlessly: connect, type, send, read what came back.
       One wiring, shared by the suite that asserts on it and the probe that investigates with
       it — a second copy would drift the day the browser's changed, and the whole value of
       either is that they drive what a person drives.

       Not shipped, and nothing arranges for that: the package bundles from each bin's entry,
       so a library no bin references is never reached. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Peer.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- For `WebRtc.connect`, which is the client half and lives in `app/` because the Host
         was the first thing to need a data channel. -->
    <ProjectReference Include="../../app/Yession.Host.fsproj" />
  </ItemGroup>

</Project>
