<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fable bindings to the `node-datachannel` npm package — libdatachannel's Node addon, the
    session's WebRTC transport. Fable-only, like app/Yession.Host.fsproj: `dotnet build`
    only type-checks it; the runnable JS comes from Fable. A standalone project so the
    bindings are a distinct layer, mirroring Fable.Jose / Fable.Dockerode.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NodeDataChannel.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

</Project>
