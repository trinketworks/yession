<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssetFile.fs" />
    <Compile Include="Dom.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Brand.fs" />
    <Compile Include="WebApp.fs" />
    <Compile Include="EditorColour.fs" />
    <!-- The launch surface's own state and fold: pure, before the model that holds it. -->
    <Compile Include="Launch.fs" />
    <!-- A command's wait for the query that will show it: pure, and above the model whose
         panels hold one. -->
    <Compile Include="Pending.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="DraftSlot.fs" />
    <Compile Include="Connection.fs" />
    <Compile Include="PeerName.fs" />
    <!-- Where a stroke sits on the landmark rail. Pure arithmetic over measurements the
         browser takes, so it sits below the view that renders the rail and below the browser
         module that measures for it. -->
    <Compile Include="Style.fs" />
    <Compile Include="Icon.fs" />
    <Compile Include="Entity.fs" />
    <Compile Include="Editor.fs" />
    <Compile Include="RichText.fs" />
    <!-- Editing a plain collaborative command line: needed by the view (which renders the
         composer) and by App (which sends it). -->
    <Compile Include="TerminalText.fs" />
    <!-- What a keydown means to a pty: pure, so the cheap tier can ask it without a
         browser. Below the view, which is the only thing that holds a key event. -->
    <Compile Include="Keystroke.fs" />
    <!-- Where focus lands when the tablist is walked: arithmetic over an index and a count,
         so the cheap tier settles the wrap-around without a strip to press keys on. Below
         the view, which is the only thing that holds the elements. -->
    <Compile Include="TabStrip.fs" />
    <Compile Include="View.fs" />
    <Compile Include="Client.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Elmish" />
    <PackageReference Include="Fable.Lit" />
    <PackageReference Include="Ylmish" />
    <PackageReference Include="Fable.Yjs" />
    <PackageReference Include="Fable.Browser.Dom" />
    <!-- The codecs for the two request bodies `Routes.fs` declares: Thoth.Json under Fable,
         Thoth.Json.Net for the .NET type-check, the split `Yession.Domain` declares for its
         own. Named here because this project names it — it arrived transitively before, and
         a dependency taken by accident is one nothing states. -->
    <PackageReference Include="Thoth.Json" />
    <PackageReference Include="Thoth.Json.Net" />
    <ProjectReference Include="..\Fable.BrowserExtras\Fable.BrowserExtras.fsproj" />
    <ProjectReference Include="..\Fable.ProseMirror\Fable.ProseMirror.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yession.Domain\Yession.Domain.fsproj" />
  </ItemGroup>

</Project>
