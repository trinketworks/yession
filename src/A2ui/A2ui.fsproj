<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A2UI v0.9.1 (https://a2ui.org), bound in F#: the protocol's messages and the basic
    catalog as types, the codec that is the one door between them and JSON, and the pure
    core a renderer and a server both need (data model pointers, `formatString`'s
    expressions, the catalog's functions, the fold over a surface's messages). Nothing in
    it is ours, so it is not `Yession.*`. It sits beside `Yession.Codecs` in the order,
    below the App and the Session that both speak it, and like it refers only to the
    domain: an agent writes the patterns `regex` runs, and the domain's matcher is the one
    that cannot backtrack (`TerminalPattern.fs` says why a `RegExp` cannot be bounded).

    The spec's own schemas, test cases and conformance suites pin it
    (`tests/Yession.Tests/A2ui.fs`, over the copies in `tests/fixtures/a2ui`).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Pointer.fs" />
    <Compile Include="Expression.fs" />
    <Compile Include="Evaluate.fs" />
    <Compile Include="Surface.fs" />
    <Compile Include="Project.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json" />
    <PackageReference Include="Thoth.Json.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yession.Domain\Yession.Domain.fsproj" />
  </ItemGroup>

</Project>
