<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Manager's pure state and wire layer: the durable registry, port and
    reaper policy, secrets/broker state, and the control-RPC codecs. Environments are
    session-owned (the sandbox seam in Yession.Domain); this project holds no
    environment authority.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Reaper.fs" />
    <Compile Include="McpWire.fs" />
    <Compile Include="State.fs" />
    <Compile Include="SecretsState.fs" />
    <Compile Include="BrokerState.fs" />
    <Compile Include="ControlWire.fs" />
    <Compile Include="SpawnWire.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json" />
    <PackageReference Include="Thoth.Json.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yession.Domain\Yession.Domain.fsproj" />
  </ItemGroup>

</Project>
