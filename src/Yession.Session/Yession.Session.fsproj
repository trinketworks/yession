<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="McpRpc.fs" />
    <!-- What a repo (`yession.yaml`) and an operator (`resources.yaml`) write, read into the
         domain's declarations. -->
    <Compile Include="ConfigFile.fs" />
    <Compile Include="OperatorProfile.fs" />
    <Compile Include="ToolJson.fs" />
    <!-- The `yession` namespace's registry, built from a turn's capabilities, and the
         argument decoding every one of its tools does for itself. -->
    <Compile Include="AgentTools.fs" />
    <!-- The agent's prompt as rules a strategy is made of. After AgentTools: the sections name
         its tools by their literals. -->
    <Compile Include="Prompting.fs" />
    <Compile Include="EventLog.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Environment.fs" />
    <!-- After Environment: a terminal runs its blocks through the session's WorkSandbox. -->
    <Compile Include="Terminals.fs" />
    <!-- After Environment: a file is read by asking the sandbox, through the same spawn a
         terminal's housekeeping uses. -->
    <Compile Include="Files.fs" />
    <!-- After Terminals: the command gate waits on the same signal the terminal wait does
         (`TerminalCommands.nextWake`), which is the point — one wait mechanism. -->
    <Compile Include="CommandGates.fs" />
    <Compile Include="Agent.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="Scheduler.fs" />
    <!-- Beside the scheduler because it is the same shape of thing: a doc update might have
         made work, so look and see. -->
    <Compile Include="Names.fs" />
    <Compile Include="Transport.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yession.Domain\Yession.Domain.fsproj" />
    <ProjectReference Include="..\Yession.Codecs\Yession.Codecs.fsproj" />
    <!-- The collaborative document the App owns (Yession.App.Collab): the Session reads and
         drains the same doc the App edits, through the App's own sync boundary. -->
    <ProjectReference Include="..\Yession.App\Yession.App.fsproj" />
  </ItemGroup>

</Project>
